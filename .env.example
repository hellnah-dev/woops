# Copy this file to `.env` and fill in your values:   cp .env.example .env
# Run the app with:   flutter run --dart-define-from-file=.env
#
# ONLY PUBLIC values go here. They are compiled into the app.
# NEVER put the Supabase service_role/secret key, Firebase service-account JSON,
# or any other secret in this file.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (starts with sb_publishable_). A legacy "anon" key also works.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Deep link for email confirmation / password reset / OAuth.
# Must also be listed in Supabase → Authentication → URL Configuration → Redirect URLs.
AUTH_REDIRECT_URL=com.woops.app://login-callback

# Social sign-in buttons (enable the providers in Supabase → Authentication → Providers first)
ENABLE_GOOGLE_SIGN_IN=false
ENABLE_APPLE_SIGN_IN=false

# Push notifications (optional). Leave empty to disable push.
# Firebase console → Project settings → General → Your apps
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.woops.app

# Public website links (for app-store listings; the app shows the bundled documents)
TERMS_URL=https://example.com/terms
PRIVACY_URL=https://example.com/privacy
GUIDELINES_URL=https://example.com/guidelines
SUPPORT_EMAIL=support@example.com

# --- Ads (Google AdMob) ---
# Debug builds ALWAYS use Google's test ads. Production ids are only used in
# release builds. Leave the production ids empty to show no ads in release.
ADS_ENABLED=true
ADS_BANNERS=true
# One full-screen ad a day opens Likes, and one opens Matches.
ADS_DAILY_UNLOCK=true
ADS_NATIVE=true
ADS_REWARDED=true
ADS_REWARD_LIKES=10
# Discover "Sponsored" card between profiles (paced).
ADS_DECK=true
# Pacing: start at 1 ad per 5 minutes, rise to ADS_MAX_PER_5MIN by day ADS_RAMP_DAYS.
ADS_MAX_PER_5MIN=5
ADS_RAMP_DAYS=7
# No ads in the first N seconds after opening the app.
ADS_GRACE_SECONDS=60
ADMOB_ANDROID_BANNER_ID=
ADMOB_ANDROID_NATIVE_ID=
ADMOB_ANDROID_REWARDED_ID=
ADMOB_ANDROID_INTERSTITIAL_ID=
ADMOB_IOS_BANNER_ID=
ADMOB_IOS_NATIVE_ID=
ADMOB_IOS_REWARDED_ID=
ADMOB_IOS_INTERSTITIAL_ID=

# Shown in error reports in the admin panel
APP_VERSION=1.0.0

# GIFs in chat: developers.giphy.com -> Create an App -> API key
GIPHY_API_KEY=
